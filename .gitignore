# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.next/
out/
**/dist/
**/build/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment variables ─────────────────────────────────────────────────────
# Root .env holds all secrets — never commit it
.env
.env.local
.env.*.local
.env.staging
# Per-package env files
**/.env
**/.env.local
**/.env.*.local
**/.env.staging

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.sln
*~

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Project specific ──────────────────────────────────────────────────────────
# Data files — use MongoDB in production
backend/src/data/*.json
!backend/src/data/globalDb.json
backend/src/data/*.bak
# Exported spreadsheets
*.xlsx
*.xls
*.csv
# Misc cache
.cache/
.turbo/
# Postman (may contain API keys)
.postman.json

# ── Old platform configs (deleted, keep ignored in case re-added) ─────────────
backend/vercel.json
backend/Procfile
.vercel/

# backend/public/ is intentionally committed — it contains the built frontend
# served by Express. Build with: cd frontend && npm run build
